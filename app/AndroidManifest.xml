<?xml version="1.0" encoding="utf-8"?>
<!--
  targetSdkVersion 22 is required: only apps targeting API 22 or lower may write
  non-public Settings.System keys such as MILLET_NO_RESTRICT_APP.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.mercuryong.fcmanchor">

    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <application
        android:label="FCM Anchor"
        android:allowBackup="false">

        <!-- Status screen only; ignores all intent extras. -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".GuardService"
            android:exported="false" />

        <!-- Exported only so the system can deliver these broadcasts; other actions are ignored. -->
        <receiver
            android:name=".TriggerReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.PACKAGE_ADDED" />
                <action android:name="android.intent.action.PACKAGE_REPLACED" />
                <action android:name="android.intent.action.PACKAGE_REMOVED" />
                <data android:scheme="package" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
